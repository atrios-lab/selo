# Nunca prefixar nada aqui com NEXT_PUBLIC_ — tudo é segredo de servidor.

# Neon: use a connection string SEM o pooler (sem "-pooler" no host). O PgBouncer
# em modo transaction quebra os advisory locks do `prisma migrate`, e nesse volume
# a conexão direta aguenta de sobra.
DATABASE_URL="postgresql://user:senha@ep-xxx.região.aws.neon.tech/neondb?sslmode=require"

# Credenciais AWS: em produção use a role da plataforma; local, chaves de um IAM user só de SES.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Configuration Set que publica os eventos no tópico SNS.
SES_CONFIGURATION_SET="selo-eventos"

# Tópico SNS que recebe os eventos do Configuration Set. A rota /api/webhooks/sns
# é pública e rejeita qualquer payload de outro ARN — não deixe vazio.
SNS_TOPIC_ARN="arn:aws:sns:us-east-1:000000000000:selo-eventos"

# Domínio do próprio Selo, verificado desde o início. Usado quando o domínio do
# cliente ainda não está VERIFIED — o envio nunca falha por DNS pendente.
SELO_FALLBACK_DOMAIN="selo.exemplo.com.br"

# Conta AWS — só pra montar o ARN da identidade ao associar o tenant SES.
AWS_ACCOUNT_ID="000000000000"

# Painel: operador único. Segredo de assinatura do cookie de sessão (12 h).
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
SELO_SESSION_SECRET=""
SELO_OPERATOR_EMAIL="voce@selo.app"
# Gere com:
#   node -e 'const{scryptSync,randomBytes}=require("crypto");const s=randomBytes(16);console.log(s.toString("hex")+":"+scryptSync(process.argv[1].normalize("NFKC"),s,32).toString("hex"))' 'sua-senha'
SELO_OPERATOR_PASSWORD_HASH=""

# Cron de verificação de domínios (a cada 15 min), enviado como
# `Authorization: Bearer <segredo>` em GET /api/cron/verify-domains.
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
SELO_CRON_SECRET=""

# Publicação automática dos registros DNS. Crie o token com escopo mínimo —
# Zone:DNS:Edit apenas nas zonas dos clientes, nada além disso. Domínio fora
# desta conta cai no caminho manual, que segue sempre disponível.
CLOUDFLARE_API_TOKEN=""
